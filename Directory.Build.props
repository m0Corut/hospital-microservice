<Project>
  <!-- Çözümdeki her projeye otomatik uygulanır; ayarı 15 csproj'ta ayrı ayrı tekrarlamayalım diye. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Null uyarıları hata sayılır: "bu alan boş gelebilir" uyarısı çalışma anında NullReferenceException olarak geri döner. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
  </PropertyGroup>
</Project>
