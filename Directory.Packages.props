<Project>
  <!-- Paket sürümleri tek yerde: csproj'lar yalnız paket adını yazar (<PackageReference Include="X" />).
       İki servis aynı paketin farklı sürümünü kullanıp birbirinden farklı davranmasın. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- 14.0.0 son MIT (ücretsiz) sürüm; 15+ ticari lisans ister. Yükseltme yok. -->
    <PackageVersion Include="AutoMapper" Version="14.0.0" />
  </ItemGroup>
  <ItemGroup Label="Veritabanı">
    <PackageVersion Include="MongoDB.Driver" Version="3.12.0" />
  </ItemGroup>
  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.16.0" />
  </ItemGroup>
</Project>
