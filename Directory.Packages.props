<Project>
  <!-- Paket sürümleri tek yerde: csproj'lar yalnız paket adını yazar (<PackageReference Include="X" />).
       İki servis aynı paketin farklı sürümünü kullanıp birbirinden farklı davranmasın. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="API">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Eşleme: Mapster (MIT). AutoMapper 14.0.0 bilinen açık (GHSA-rvv3-g6hj-g44x), 15+ ticari lisans → Muhammet kararı 2026-10-09. -->
    <PackageVersion Include="Mapster" Version="10.0.13" />
    <PackageVersion Include="Ocelot" Version="25.0.1" />
    <PackageVersion Include="Mapster.DependencyInjection" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Label="Veritabanı">
    <PackageVersion Include="MongoDB.Driver" Version="3.12.0" />
  </ItemGroup>
  <ItemGroup Label="CQRS (Pharmacy)">
    <!-- MediatR 12.5.0 = son Apache-2.0 sürüm. 13.0.0 ve sonrası (14.x dahil) ticari lisans anahtarı ister (nuspec: license file + requireLicenseAcceptance). -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
  </ItemGroup>
  <ItemGroup Label="Güvenlik">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="E-posta">
    <PackageVersion Include="MailKit" Version="4.18.1" />
  </ItemGroup>
  <ItemGroup Label="SQL Server / EF Core">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
  </ItemGroup>
</Project>
