@using Hastane.WebUI.ViewModels.Public
@model BranchesIndexViewModel
@{
    ViewData["Title"] = "Branşlar";
}

<div class="section-head">
    <h1 class="h2">Branşlar</h1>
    <p>Bir branş seçin, o branştaki doktorları görün.</p>
    <span class="bar"></span>
</div>

@if (Model.Branches.Count == 0)
{
    <div class="panel-card"><partial name="_EmptyState" model="@("Henüz tanımlı branş yok.")" /></div>
}
else
{
    <div class="row g-3">
        @foreach (var branch in Model.Branches)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <a class="text-decoration-none" asp-controller="Doctors" asp-action="Index" asp-route-branchId="@branch.Id">
                    <div class="card card-branch">
                        <div class="card-body text-center">
                            <span class="branch-icon mb-2" aria-hidden="true"><img src="@UiKit.BranchIcon(branch.Name)" alt="" /></span>
                            <div class="fw-semibold text-body">@branch.Name</div>
                            @if (!string.IsNullOrWhiteSpace(branch.Description))
                            {
                                <div class="small text-muted">@branch.Description</div>
                            }
                            <div class="small mt-2 text-primary">Doktorları gör <i class="bi bi-arrow-right" aria-hidden="true"></i></div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
