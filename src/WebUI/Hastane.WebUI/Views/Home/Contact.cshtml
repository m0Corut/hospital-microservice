@model ContactFormViewModel
@{
    ViewData["Title"] = "İletişim";
}

<h1 class="page-title">İletişim</h1>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="panel-card p-4 h-100">
            <h2 class="h5">Bize ulaşın</h2>
            <p class="text-muted small">Aşağıdaki bilgiler kurgusaldır (eğitim projesi).</p>
            <ul class="list-unstyled mb-0">
                <li class="d-flex gap-2 mb-3"><i class="bi bi-geo-alt text-primary" aria-hidden="true"></i><span>Örnek Mah. Sağlık Cad. No: 1<br />Örnekşehir, 00000</span></li>
                <li class="d-flex gap-2 mb-3"><i class="bi bi-telephone text-primary" aria-hidden="true"></i><span>0 (000) 000 00 00</span></li>
                <li class="d-flex gap-2 mb-3"><i class="bi bi-envelope text-primary" aria-hidden="true"></i><span class="text-break">iletisim@hastane.example</span></li>
                <li class="d-flex gap-2"><i class="bi bi-clock text-primary" aria-hidden="true"></i><span>Hafta içi 09:00 - 18:00</span></li>
            </ul>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="panel-card p-4">
            <h2 class="h5">Mesaj gönderin</h2>
            <div class="alert alert-info py-2 small" role="note">Eğitim projesi: form hiçbir yere gönderilmez ve mesajınız kaydedilmez.</div>
            <form method="post" asp-controller="Home" asp-action="Contact" asp-area="" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" autocomplete="name" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Subject" class="form-label"></label>
                        <input asp-for="Subject" class="form-control" />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Message" class="form-label"></label>
                        <textarea asp-for="Message" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Message" class="text-danger small"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3">Gönder</button>
            </form>
        </div>
    </div>
</div>
