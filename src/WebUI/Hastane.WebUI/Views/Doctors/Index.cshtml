@using Hastane.WebUI.ViewModels.Public
@model DoctorSearchViewModel
@{
    ViewData["Title"] = "Doktorlar";
    var f = Model.Filter;
    var selected = Model.SelectedBranchIds;
    object PageRoute(int page) => new { q = f.Q, branchId = f.BranchId, gender = f.Gender, city = f.City, minFee = f.MinFee, maxFee = f.MaxFee, date = f.Date, sort = f.Sort, page };
}

<a class="back-link" href="~/"><i class="bi bi-arrow-left" aria-hidden="true"></i>Ana sayfaya dön</a>

<div class="row g-4">
    <aside class="col-lg-3">
        <form method="get" id="filterForm" asp-controller="Doctors" asp-action="Index" class="panel-card filter-card">
            <div class="filter-title"><span><i class="bi bi-funnel me-2" aria-hidden="true"></i>Filtrele</span></div>
            <div class="filter-body">
                <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                <div class="filter-group">
                    <label for="q" class="form-label">Doktor adı ya da uzmanlık</label>
                    <input type="search" id="q" name="q" value="@f.Q" class="form-control" maxlength="100" list="q-suggest" autocomplete="off" />
                    <datalist id="q-suggest"></datalist>
                </div>
                <div class="filter-group">
                    <label for="date" class="form-label">Müsait gün</label>
                    <input type="date" id="date" name="date" value="@f.Date" class="form-control" />
                </div>
                <div class="filter-group">
                    <span class="form-label d-block">Cinsiyet</span>
                    <div class="form-check"><input class="form-check-input" type="radio" name="gender" id="g-any" value="" checked="@string.IsNullOrEmpty(f.Gender)" /><label class="form-check-label" for="g-any">Fark etmez</label></div>
                    <div class="form-check"><input class="form-check-input" type="radio" name="gender" id="g-male" value="Male" checked="@(f.Gender == "Male")" /><label class="form-check-label" for="g-male">Erkek doktor</label></div>
                    <div class="form-check"><input class="form-check-input" type="radio" name="gender" id="g-female" value="Female" checked="@(f.Gender == "Female")" /><label class="form-check-label" for="g-female">Kadın doktor</label></div>
                    <div class="form-check"><input class="form-check-input" type="radio" name="gender" id="g-other" value="Other" checked="@(f.Gender == "Other")" /><label class="form-check-label" for="g-other">Diğer</label></div>
                </div>
                <div class="filter-group">
                    <span class="form-label d-block">Branş</span>
                    @if (Model.Branches.Count == 0)
                    {
                        <div class="small text-muted">Branş listesi yüklenemedi.</div>
                    }
                    @foreach (var branch in Model.Branches)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="branchId" id="b-@branch.Id" value="@branch.Id" checked="@selected.Contains(branch.Id)" />
                            <label class="form-check-label" for="b-@branch.Id">@branch.Name</label>
                        </div>
                    }
                </div>
                <div class="filter-group">
                    <label for="city" class="form-label">Şehir</label>
                    <input type="text" id="city" name="city" value="@f.City" class="form-control" maxlength="100" />
                </div>
                <div class="filter-group">
                    <span class="form-label d-block">Ücret aralığı</span>
                    <div class="row g-2">
                        <div class="col-6"><input type="number" id="minFee" name="minFee" value="@f.MinFee" class="form-control" min="0" step="any" placeholder="En düşük" aria-label="En düşük ücret" /></div>
                        <div class="col-6"><input type="number" id="maxFee" name="maxFee" value="@f.MaxFee" class="form-control" min="0" step="any" placeholder="En yüksek" aria-label="En yüksek ücret" /></div>
                    </div>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-accent">Ara</button>
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Doctors" asp-action="Index">Temizle</a>
                </div>
            </div>
        </form>
    </aside>

    <section class="col-lg-9">
        <div class="result-bar">
            <h1>
                @if (Model.Doctors.Count == 0)
                {
                    <text>Doktorlar</text>
                }
                else
                {
                    <text><strong>@Model.TotalCount</strong> doktor bulundu</text>
                }
            </h1>
            <div class="d-flex align-items-center gap-2">
                <label for="sort" class="small text-muted mb-0">Sıralama</label>
                <select id="sort" name="sort" form="filterForm" class="form-select form-select-sm w-auto" onchange="this.form.submit()">
                    <option value="">Ada göre</option>
                    <option value="feeAsc" selected="@(f.Sort == "feeAsc")">Ücret: önce düşük</option>
                    <option value="feeDesc" selected="@(f.Sort == "feeDesc")">Ücret: önce yüksek</option>
                </select>
            </div>
        </div>

        @if (Model.Doctors.Count == 0)
        {
            <div class="panel-card"><partial name="_EmptyState" model="@("Aramanıza uygun doktor bulunamadı.")" /></div>
        }
        else
        {
            @foreach (var card in Model.Doctors)
            {
                <partial name="_DoctorCard" model="card" />
            }

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4" aria-label="Sayfalar">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(f.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Doctors", PageRoute(Math.Max(1, f.Page - 1)))">Önceki</a>
                        </li>
                        <li class="page-item disabled"><span class="page-link">@f.Page / @Model.TotalPages</span></li>
                        <li class="page-item @(f.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("Index", "Doctors", PageRoute(f.Page + 1))">Sonraki</a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </section>
</div>

@section Scripts {
    <script>
        // Yazdıkça öneri: /doctor-suggest (Doctor servisi suggest ucu). Hata olursa sessizce vazgeçilir, arama kutusu aynen çalışır.
        (function () {
            var input = document.getElementById('q');
            var list = document.getElementById('q-suggest');
            if (!input || !list || !window.fetch) return;
            var timer = null, last = '';
            input.addEventListener('input', function () {
                var value = input.value.trim();
                clearTimeout(timer);
                if (value.length < 2 || value === last) return;
                timer = setTimeout(function () {
                    last = value;
                    fetch('/doctor-suggest?q=' + encodeURIComponent(value), { headers: { 'Accept': 'application/json' } })
                        .then(function (r) { return r.ok ? r.json() : []; })
                        .then(function (items) {
                            list.innerHTML = '';
                            items.forEach(function (text) {
                                var option = document.createElement('option');
                                option.value = text;
                                list.appendChild(option);
                            });
                        })
                        .catch(function () { });
                }, 200);
            });
        })();
    </script>
}
