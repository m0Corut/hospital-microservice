@using Hastane.WebUI.ViewModels.Social
@using Hastane.WebUI.ViewModels.Public
@model NotificationsViewModel
@{
    ViewData["Title"] = "Bildirimler";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="page-title mb-0">Bildirimler</h1>
    @if (Model.UnreadCount > 0)
    {
        <form asp-area="" asp-controller="Notifications" asp-action="ReadAll" method="post">
            <button type="submit" class="btn btn-outline-primary btn-sm"><i class="bi bi-check2-all me-1" aria-hidden="true"></i>Tümünü okundu yap (@Model.UnreadCount)</button>
        </form>
    }
</div>

<div class="panel-card">
    @if (Model.Items.Count == 0)
    {
        <div class="p-4"><partial name="_EmptyState" model="@("Henüz bildiriminiz yok.")" /></div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var n in Model.Items)
            {
                <li class="list-group-item d-flex flex-wrap justify-content-between align-items-start gap-2 @(n.IsRead ? "" : "bg-primary-subtle")">
                    <div class="min-w-0 flex-grow-1">
                        <div class="@(n.IsRead ? "" : "fw-bold")">
                            @if (!n.IsRead)
                            {
                                <span class="badge text-bg-primary me-1">Yeni</span>
                            }
                            @n.Title
                        </div>
                        <div class="text-break small">@n.Message</div>
                        <div class="text-muted small mt-1">@DisplayText.DateTimeLocal(n.CreatedAt)</div>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        @if (n.SafeLink is not null)
                        {
                            @* Bağlantıya tıklama = önce okundu yap, sonra git (POST). Bağlantı yalnız yerel yol ise gösterilir. *@
                            <form asp-area="" asp-controller="Notifications" asp-action="Open" asp-route-id="@n.Id" method="post">
                                <input type="hidden" name="link" value="@n.SafeLink" />
                                <input type="hidden" name="page" value="@Model.Page" />
                                <button type="submit" class="btn btn-primary btn-sm">Aç</button>
                            </form>
                        }
                        @if (!n.IsRead)
                        {
                            <form asp-area="" asp-controller="Notifications" asp-action="Read" asp-route-id="@n.Id" method="post">
                                <input type="hidden" name="page" value="@Model.Page" />
                                <button type="submit" class="btn btn-outline-secondary btn-sm">Okundu yap</button>
                            </form>
                        }
                    </div>
                </li>
            }
        </ul>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Sayfalar">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-area="" asp-controller="Notifications" asp-action="Index" asp-route-page="@(Model.Page - 1)">Önceki</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-area="" asp-controller="Notifications" asp-action="Index" asp-route-page="@(Model.Page + 1)">Sonraki</a>
            </li>
        </ul>
    </nav>
}
