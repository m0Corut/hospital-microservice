@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre değiştir";
}

<h1 class="page-title">Şifre değiştir</h1>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="panel-card p-4">
            <form asp-action="ChangePassword" asp-controller="Account" asp-area="" method="post" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    <div class="form-text">En az 8 karakter; büyük harf, küçük harf ve rakam içermeli.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <p class="small text-muted">Şifre değişince güvenliğiniz için oturumunuz kapanır ve yeni şifrenizle yeniden giriş yaparsınız.</p>
                <button type="submit" class="btn btn-accent">Şifreyi değiştir</button>
                <a class="btn btn-outline-secondary" asp-action="Profile">Vazgeç</a>
            </form>
        </div>
    </div>
</div>
