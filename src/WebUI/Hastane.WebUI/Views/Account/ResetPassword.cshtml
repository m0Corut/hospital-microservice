@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni şifre belirle";
    var linkMissing = string.IsNullOrWhiteSpace(Model.Token) || string.IsNullOrWhiteSpace(Model.Email);
}

<div class="auth-split panel-card">
    <div class="auth-art" aria-hidden="true"><img src="~/img/login.svg" alt="" /></div>
    <div class="auth-form">
        <h1 class="h3 mb-1">Yeni şifre belirle</h1>
        @if (linkMissing)
        {
            <div class="alert alert-danger py-2 small mt-3">Bağlantı geçersiz ya da süresi dolmuş. Lütfen yeni bir sıfırlama bağlantısı isteyin.</div>
            <a class="btn btn-accent w-100" asp-action="ForgotPassword" asp-controller="Account" asp-area="">Yeni bağlantı iste</a>
        }
        else
        {
            <p class="text-muted mb-4">Hesabınız için yeni bir şifre seçin.</p>
            <form asp-action="ResetPassword" asp-controller="Account" asp-area="" method="post" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                @* Belirteç ve e-posta yalnız gizli alanda taşınır; sayfada görünür yazılmaz. *@
                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    <div class="form-text">En az 8 karakter; büyük harf, küçük harf ve rakam içermeli.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-accent btn-lg w-100">Şifreyi sıfırla</button>
            </form>
            <p class="small text-center mt-3 mb-0"><a asp-action="ForgotPassword" asp-controller="Account" asp-area="">Yeni bağlantı iste</a></p>
        }
    </div>
</div>
