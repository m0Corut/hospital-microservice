@model LoginViewModel
@{
    ViewData["Title"] = "Giriş yap";
}

<div class="auth-split panel-card">
    <div class="auth-art" aria-hidden="true"><img src="~/img/login.svg" alt="" /></div>
    <div class="auth-form">
        <h1 class="h3 mb-1">Giriş yap</h1>
        <p class="text-muted mb-4">Randevularınıza ve reçetelerinize ulaşmak için hesabınızla giriş yapın.</p>
        <form asp-action="Login" asp-controller="Account" asp-area="" method="post" novalidate>
            <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="text-end small mb-3"><a asp-action="ForgotPassword" asp-controller="Account" asp-area="">Şifremi unuttum</a></div>
            <button type="submit" class="btn btn-accent btn-lg w-100">Giriş yap</button>
        </form>
        <p class="small text-center mt-3 mb-0">Hesabınız yok mu? <a asp-action="Register" asp-controller="Account" asp-area="">Kayıt olun</a></p>
    </div>
</div>
