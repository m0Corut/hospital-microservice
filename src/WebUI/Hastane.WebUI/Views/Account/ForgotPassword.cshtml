@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Şifremi unuttum";
}

<div class="auth-split panel-card">
    <div class="auth-art" aria-hidden="true"><img src="~/img/login.svg" alt="" /></div>
    <div class="auth-form">
        <h1 class="h3 mb-1">Şifremi unuttum</h1>
        <p class="text-muted mb-4">Hesabınızın e-posta adresini yazın; kayıtlıysa şifre sıfırlama bağlantısını göndeririz.</p>
        <form asp-action="ForgotPassword" asp-controller="Account" asp-area="" method="post" novalidate>
            <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-accent btn-lg w-100">Sıfırlama bağlantısı gönder</button>
        </form>
        <p class="small text-center mt-3 mb-0"><a asp-action="Login" asp-controller="Account" asp-area="">Girişe dön</a></p>
    </div>
</div>
