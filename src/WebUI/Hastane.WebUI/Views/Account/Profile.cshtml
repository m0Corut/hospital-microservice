@model ProfileViewModel
@{
    ViewData["Title"] = "Hesap ayarları";
}

<h1 class="page-title">Hesap ayarları</h1>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="panel-card p-4">
            <h2 class="h5 mb-3"><i class="bi bi-person-gear me-1 text-primary" aria-hidden="true"></i>Kişisel bilgiler</h2>
            <form asp-action="Profile" asp-controller="Account" asp-area="" method="post" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" maxlength="100" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" maxlength="100" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="profile-email" class="form-label">E-posta</label>
                    <input id="profile-email" class="form-control" value="@Model.Email" readonly />
                    <div class="form-text">E-posta adresi buradan değiştirilemez.</div>
                </div>
                <div class="mb-3">
                    <div class="form-label">Roller</div>
                    <div>
                        @foreach (var role in Model.Roles)
                        {
                            <span class="badge text-bg-info">@UiText.RoleName(role)</span>
                        }
                        @if (Model.Roles.Count == 0)
                        {
                            <span class="text-muted small">Rol yok</span>
                        }
                    </div>
                </div>
                <button type="submit" class="btn btn-accent">Kaydet</button>
                <a class="btn btn-outline-secondary" asp-action="ChangePassword">Şifre değiştir</a>
            </form>
        </div>
    </div>
</div>
