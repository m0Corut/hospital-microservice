@model ErrorPageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="panel-card p-4 p-md-5 text-center mx-auto error-card">
    @if (Model.Code == 404)
    {
        <img class="error-art" src="~/img/404.svg" alt="" width="260" height="179" />
    }
    else
    {
        <div class="display-4 text-primary fw-bold">@Model.Code</div>
    }
    <h1 class="h4 mt-2">@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    @if (Model.RequestId is not null)
    {
        <p class="small text-muted mb-3">Başvuru kodu: <code class="text-break">@Model.RequestId</code></p>
    }
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a href="~/" class="btn btn-primary">Ana sayfaya dön</a>
        @if (Model.Code == 404)
        {
            <a href="~/Doctors" class="btn btn-outline-primary">Doktor ara</a>
        }
    </div>
</div>
