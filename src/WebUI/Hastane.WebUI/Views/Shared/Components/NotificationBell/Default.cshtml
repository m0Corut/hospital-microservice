@using Hastane.WebUI.ViewComponents
@model long?
@{
    var badge = NavBadge.Text(Model);
}
<a class="nav-link nav-bell position-relative" href="~/Notifications" aria-label="@(badge is null ? "Bildirimler" : $"Bildirimler, {Model} okunmamış")" title="Bildirimler">
    <i class="bi bi-bell fs-5" aria-hidden="true"></i>
    @if (badge is not null)
    {
        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill text-bg-danger notif-count">@badge</span>
    }
</a>
