@{
    // Doctor paneli iskeleti: ortak _Layout içinde profil kartlı kenar menü + içerik. Yetki burada değil, DoctorAreaController'dadır.
    Layout = "~/Views/Shared/_Layout.cshtml";
    var side = new PanelSideViewModel(
        User.Identity?.Name ?? string.Empty,
        "Doktor",
        null,
        [
            new("speedometer2", "Özet", "Doctor", "Home"),
            new("calendar-check", "Randevularım", "Doctor", "Appointments"),
            new("list-ol", "Sıra", "Doctor", "Queue"),
            new("calendar-week", "Takvim", "Doctor", "Calendar"),
            new("people", "Hastalarım", "Doctor", "Patients"),
            new("chat-dots", "Mesajlar", "", "Messages", "Index", true),
            new("clock-history", "Çalışma Saatleri", "Doctor", "Schedule"),
            new("file-earmark-medical", "Reçeteler", "Doctor", "Prescriptions"),
            new("receipt", "Faturalarım", "Doctor", "Invoices"),
            new("person-vcard", "Profilim", "Doctor", "Profile"),
            new("share", "Sosyal Medya", "Doctor", "Social"),
            new("star", "Yorumlarım", "Doctor", "Reviews"),
            new("person-gear", "Hesap ayarları", "", "Account", "Profile"),
        ]);
}

<div class="panel-shell">
    <partial name="_PanelSide" model="side" />
    <div class="panel-content">
        @RenderBody()
    </div>
</div>

@* İç içe düzen: sayfaların Styles/Scripts bölümlerini ana _Layout'a iletir (yoksa bölüm tanımlayan sayfa 500 verir). *@
@section Styles { @await RenderSectionAsync("Styles", required: false) }
@section Scripts { @await RenderSectionAsync("Scripts", required: false) }
