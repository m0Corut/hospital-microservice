@model IReadOnlyList<PatientRow>
@{
    ViewData["Title"] = "Hastalarım";
}

<h1 class="page-title">Hastalarım</h1>

<div class="panel-card p-4">
    @if (Model.Count == 0)
    {
        <partial name="_EmptyState" model="@("Henüz randevusu olan hasta yok.")" />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Hasta</th><th>Randevu sayısı</th><th>Son randevu</th><th></th></tr></thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        <tr>
                            <td>
                                <span class="d-flex align-items-center gap-2">
                                    <partial name="_Avatar" model="@(new AvatarViewModel(null, row.Label, "sm"))" />
                                    <strong>@row.Label</strong>
                                </span>
                            </td>
                            <td>@row.AppointmentCount</td>
                            <td>@DoctorPanelFormat.DateTimeText(row.LastDate)</td>
                            <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-area="Doctor" asp-controller="Appointments" asp-action="Details" asp-route-id="@row.LastAppointmentId">Son randevu</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
