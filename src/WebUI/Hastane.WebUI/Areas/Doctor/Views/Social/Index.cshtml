@model SocialFormViewModel
@{
    ViewData["Title"] = "Sosyal Medya";
    var fields = new (string Name, string Label, string Icon)[]
    {
        ("Facebook", "Facebook", "facebook"),
        ("X", "X (Twitter)", "twitter-x"),
        ("Instagram", "Instagram", "instagram"),
        ("LinkedIn", "LinkedIn", "linkedin"),
        ("Pinterest", "Pinterest", "pinterest"),
        ("YouTube", "YouTube", "youtube"),
    };
}

<h1 class="page-title">Sosyal Medya</h1>
<p class="text-muted">Profil sayfanızda herkese açık ikon olarak görünür. Yalnız <code>http://</code> ya da <code>https://</code> ile başlayan adresler kabul edilir; boş bıraktığınız alan gösterilmez.</p>

<form method="post" asp-area="Doctor" asp-controller="Social" asp-action="Index" novalidate>
    <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
    <div class="panel-card p-4 mb-3">
        <div class="row g-3">
            @foreach (var f in fields)
            {
                <div class="col-md-6">
                    <label for="SocialLinks_@f.Name" class="form-label"><i class="bi bi-@f.Icon me-1" aria-hidden="true"></i>@f.Label</label>
                    <input id="SocialLinks_@f.Name" name="SocialLinks.@f.Name" type="url" inputmode="url" maxlength="300" class="form-control" placeholder="https://"
                           value="@(f.Name switch { "Facebook" => Model.SocialLinks.Facebook, "X" => Model.SocialLinks.X, "Instagram" => Model.SocialLinks.Instagram, "LinkedIn" => Model.SocialLinks.LinkedIn, "Pinterest" => Model.SocialLinks.Pinterest, _ => Model.SocialLinks.YouTube })" />
                    @Html.ValidationMessage("SocialLinks." + f.Name, new { @class = "text-danger small" })
                </div>
            }
        </div>
    </div>
    <button type="submit" class="btn btn-primary mb-4">Kaydet</button>
</form>
