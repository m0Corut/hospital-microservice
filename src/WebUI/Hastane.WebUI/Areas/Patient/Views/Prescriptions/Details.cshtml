@model PrescriptionDetailViewModel
@{
    ViewData["Title"] = "Reçete";
    var p = Model.Prescription;
}

<partial name="_PatientNav" />

<div class="panel-card p-4 mb-4">
    <h1 class="h4 mb-1">Reçete</h1>
    <div class="text-muted">@Model.DoctorName · @DisplayText.DateTimeLocal(p.IssuedAt)</div>
    @if (!string.IsNullOrWhiteSpace(p.Notes))
    {
        <p class="mt-3 mb-0"><strong>Doktor notu:</strong> @p.Notes</p>
    }
</div>

<div class="panel-card mb-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>#</th><th>İlaç</th><th>Doz</th><th>Sıklık</th><th>Süre</th><th>Kullanım</th></tr>
            </thead>
            <tbody>
                @foreach (var item in p.Items.OrderBy(i => i.LineNo))
                {
                    <tr>
                        <td>@item.LineNo</td>
                        <td>@item.MedicineName</td>
                        <td>@item.Dosage</td>
                        <td>@item.Frequency</td>
                        <td>@item.DurationDays gün</td>
                        <td>@item.Instructions</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<a class="btn btn-outline-secondary" asp-action="Index">Reçetelerime dön</a>
<a class="btn btn-outline-primary" asp-controller="Appointments" asp-action="Details" asp-route-id="@p.AppointmentId">İlgili randevu</a>
