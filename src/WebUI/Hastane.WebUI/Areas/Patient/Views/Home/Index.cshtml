@model PatientHomeViewModel
@{
    ViewData["Title"] = "Hasta paneli";
}

<partial name="_PatientNav" />

<h1 class="h4 mb-3">Hasta paneli</h1>

<div class="row g-4">
    <div class="col-lg-7">
        <section class="panel-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Yaklaşan randevular</h2>
                <a asp-controller="Appointments" asp-action="Index" class="small">Tümü</a>
            </div>
            @if (Model.AppointmentsUnavailable)
            {
                <div class="alert alert-warning mb-0" role="alert">Randevular şu anda yüklenemiyor.</div>
            }
            else if (Model.Upcoming.Count == 0)
            {
                <p class="text-muted mb-2">Yaklaşan randevunuz yok.</p>
                <a class="btn btn-accent btn-sm" asp-area="" asp-controller="Doctors" asp-action="Index">Doktor bul</a>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var row in Model.Upcoming)
                    {
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                           asp-controller="Appointments" asp-action="Details" asp-route-id="@row.Appointment.Id">
                            <span>
                                <strong>@DisplayText.DateTimeLocal(row.Appointment.AppointmentDate)</strong><br />
                                <span class="small text-muted">@row.DoctorName</span>
                            </span>
                            <span class="badge @DisplayText.AppointmentBadge(row.Appointment.Status)">@DisplayText.AppointmentStatus(row.Appointment.Status)</span>
                        </a>
                    }
                </div>
            }
        </section>
    </div>
    <div class="col-lg-5">
        <section class="panel-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h5 mb-0">Son reçeteler</h2>
                <a asp-controller="Prescriptions" asp-action="Index" class="small">Tümü</a>
            </div>
            @if (Model.PrescriptionsUnavailable)
            {
                <div class="alert alert-warning mb-0" role="alert">Reçeteler şu anda yüklenemiyor.</div>
            }
            else if (Model.Prescriptions.Count == 0)
            {
                <p class="text-muted mb-0">Henüz reçeteniz yok.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var row in Model.Prescriptions)
                    {
                        <a class="list-group-item list-group-item-action"
                           asp-controller="Prescriptions" asp-action="Details" asp-route-id="@row.Prescription.Id">
                            <strong>@DisplayText.DateLocal(row.Prescription.IssuedAt)</strong>
                            <span class="small text-muted">· @row.DoctorName · @row.Prescription.ItemCount ilaç</span>
                        </a>
                    }
                </div>
            }
        </section>
    </div>
</div>
