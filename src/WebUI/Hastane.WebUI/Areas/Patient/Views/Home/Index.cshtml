@model PatientHomeViewModel
@{
    ViewData["Title"] = "Hasta paneli";
}

<h1 class="page-title">Hasta paneli</h1>

<div class="row g-3 mb-4">
    <div class="col-sm-6">
        <div class="panel-card stat-tile">
            <span class="st-icon tone-blue"><i class="bi bi-calendar-check" aria-hidden="true"></i></span>
            <div>
                <div class="st-value">@(Model.AppointmentsUnavailable ? "-" : Model.UpcomingCount.ToString())</div>
                <div class="st-label">Yaklaşan randevu</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="panel-card stat-tile">
            <span class="st-icon tone-teal"><i class="bi bi-file-earmark-medical" aria-hidden="true"></i></span>
            <div>
                <div class="st-value">@(Model.PrescriptionsUnavailable ? "-" : Model.PrescriptionCount.ToString())</div>
                <div class="st-label">Reçete</div>
            </div>
        </div>
    </div>
</div>

<section class="panel-card p-4">
    <ul class="nav panel-tabs" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" id="tab-appointments-btn" data-bs-toggle="tab" data-bs-target="#tab-appointments" type="button" role="tab" aria-controls="tab-appointments" aria-selected="true">Yaklaşan randevular</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" id="tab-prescriptions-btn" data-bs-toggle="tab" data-bs-target="#tab-prescriptions" type="button" role="tab" aria-controls="tab-prescriptions" aria-selected="false">Son reçeteler</button></li>
    </ul>
    <div class="tab-content">
        <div class="tab-pane fade show active" id="tab-appointments" role="tabpanel" aria-labelledby="tab-appointments-btn" tabindex="0">
            <div class="d-flex justify-content-end mb-2"><a asp-controller="Appointments" asp-action="Index" class="small">Tümü</a></div>
            @if (Model.AppointmentsUnavailable)
            {
                <div class="alert alert-warning mb-0" role="alert">Randevular şu anda yüklenemiyor.</div>
            }
            else if (Model.Upcoming.Count == 0)
            {
                <p class="text-muted mb-2">Yaklaşan randevunuz yok.</p>
                <a class="btn btn-accent btn-sm" asp-area="" asp-controller="Doctors" asp-action="Index">Doktor bul</a>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead><tr><th>Tarih</th><th>Doktor</th><th>Durum</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var row in Model.Upcoming)
                            {
                                <tr>
                                    <td><strong>@DisplayText.DateTimeLocal(row.Appointment.AppointmentDate)</strong></td>
                                    <td>@row.DoctorName</td>
                                    <td><span class="badge @DisplayText.AppointmentBadge(row.Appointment.Status)">@DisplayText.AppointmentStatus(row.Appointment.Status)</span></td>
                                    <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-controller="Appointments" asp-action="Details" asp-route-id="@row.Appointment.Id">Ayrıntı</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="tab-pane fade" id="tab-prescriptions" role="tabpanel" aria-labelledby="tab-prescriptions-btn" tabindex="0">
            <div class="d-flex justify-content-end mb-2"><a asp-controller="Prescriptions" asp-action="Index" class="small">Tümü</a></div>
            @if (Model.PrescriptionsUnavailable)
            {
                <div class="alert alert-warning mb-0" role="alert">Reçeteler şu anda yüklenemiyor.</div>
            }
            else if (Model.Prescriptions.Count == 0)
            {
                <p class="text-muted mb-0">Henüz reçeteniz yok.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var row in Model.Prescriptions)
                    {
                        <a class="list-group-item list-group-item-action"
                           asp-controller="Prescriptions" asp-action="Details" asp-route-id="@row.Prescription.Id">
                            <strong>@DisplayText.DateLocal(row.Prescription.IssuedAt)</strong>
                            <span class="small text-muted">· @row.DoctorName · @row.Prescription.ItemCount ilaç</span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</section>
