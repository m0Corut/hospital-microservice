@{
    // Patient paneli iskeleti: ortak _Layout içinde profil kartlı kenar menü + içerik. Yetki burada değil, PatientAreaController'dadır.
    Layout = "~/Views/Shared/_Layout.cshtml";
    var side = new PanelSideViewModel(
        User.Identity?.Name ?? string.Empty,
        "Hasta",
        null,
        [
            new("speedometer2", "Panel", "Patient", "Home"),
            new("calendar-check", "Randevularım", "Patient", "Appointments"),
            new("file-earmark-medical", "Reçetelerim", "Patient", "Prescriptions"),
            new("credit-card", "Ödemelerim", "Patient", "Payments"),
            new("receipt", "Faturalarım", "Patient", "Invoices"),
            new("list-ol", "Sıram", "Patient", "Queue"),
            new("bag-check", "Siparişlerim", "Patient", "Orders"),
            new("person-vcard", "Profil Bilgilerim", "Patient", "Profile"),
            new("heart", "Favorilerim", "Patient", "Favorites"),
            new("chat-dots", "Mesajlar", "", "Messages", "Index", true),
            new("person-gear", "Hesap ayarları", "", "Account", "Profile"),
        ]);
}

<div class="panel-shell">
    <partial name="_PanelSide" model="side" />
    <div class="panel-content">
        @RenderBody()
    </div>
</div>

@* İç içe düzen: sayfaların Styles/Scripts bölümlerini ana _Layout'a iletir (yoksa bölüm tanımlayan sayfa 500 verir). *@
@section Styles { @await RenderSectionAsync("Styles", required: false) }
@section Scripts { @await RenderSectionAsync("Scripts", required: false) }
