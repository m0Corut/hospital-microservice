@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string Active(string controller) => string.Equals(current, controller, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
}

<ul class="nav nav-pills mb-4 flex-wrap gap-1">
    <li class="nav-item"><a class="nav-link @Active("Home")" asp-area="Patient" asp-controller="Home" asp-action="Index">Panel</a></li>
    <li class="nav-item"><a class="nav-link @Active("Appointments")" asp-area="Patient" asp-controller="Appointments" asp-action="Index">Randevularım</a></li>
    <li class="nav-item"><a class="nav-link @Active("Prescriptions")" asp-area="Patient" asp-controller="Prescriptions" asp-action="Index">Reçetelerim</a></li>
    <li class="nav-item"><a class="nav-link @Active("Payments")" asp-area="Patient" asp-controller="Payments" asp-action="Index">Ödemelerim</a></li>
    <li class="nav-item"><a class="nav-link @Active("Invoices")" asp-area="Patient" asp-controller="Invoices" asp-action="Index">Faturalarım</a></li>
</ul>
