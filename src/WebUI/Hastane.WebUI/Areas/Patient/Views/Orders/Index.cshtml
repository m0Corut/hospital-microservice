@using Hastane.WebUI.ViewModels.Orders
@model PatientOrderListViewModel
@{
    ViewData["Title"] = "Siparişlerim";
}

<h1 class="h4 mb-3">Siparişlerim</h1>

@if (Model.Items.Count == 0)
{
    <div class="panel-card p-4 text-muted">Henüz siparişiniz yok.</div>
}
else
{
    <div class="panel-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Sipariş no</th><th>Tarih</th><th>Ürün</th><th>Tutar</th><th>Durum</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.Items)
                    {
                        <tr>
                            <td><code>@o.OrderNumber</code></td>
                            <td>@DisplayText.DateTimeLocal(o.CreatedAt)</td>
                            <td>@o.ItemCount kalem</td>
                            <td>@OrderDisplay.Money(o.TotalAmount, o.Currency)</td>
                            <td><span class="badge @OrderDisplay.Badge(o.Status)">@OrderDisplay.Status(o.Status)</span></td>
                            <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@o.Id">Ayrıntı</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Sayfalar">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)">Önceki</a></li>
                <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)">Sonraki</a></li>
            </ul>
        </nav>
    }
}
