@model CreateAppointmentViewModel
@{
    ViewData["Title"] = "Randevu al";
}

<partial name="_PatientNav" />

<div class="row">
    <div class="col-lg-7">
        <div class="panel-card p-4">
            <h1 class="h4 mb-1">Randevu al</h1>
            <p class="text-muted">Doktor: <strong>@Model.DoctorName</strong></p>

            <form asp-action="Create" asp-controller="Appointments" asp-area="Patient" method="post" novalidate>
                <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
                <input type="hidden" asp-for="DoctorId" />
                <div class="mb-3">
                    <label asp-for="AppointmentLocal" class="form-label"></label>
                    <input asp-for="AppointmentLocal" type="datetime-local" class="form-control" />
                    <span asp-validation-for="AppointmentLocal" class="text-danger small"></span>
                    <div class="form-text">Doktorun çalışma günlerinden birini seçin. Dolu saatler için sistem sizi uyarır.</div>
                </div>
                <button type="submit" class="btn btn-primary">Randevuyu oluştur</button>
                <a class="btn btn-outline-secondary" asp-area="" asp-controller="Doctors" asp-action="Details" asp-route-id="@Model.DoctorId">Vazgeç</a>
            </form>
        </div>
    </div>
    <div class="col-lg-5 mt-4 mt-lg-0">
        <div class="panel-card p-4">
            <h2 class="h6">Doktorun çalışma programı</h2>
            @if (Model.Schedule.Count == 0)
            {
                <p class="text-muted small mb-0">Program bilgisi yok.</p>
            }
            else
            {
                <ul class="list-unstyled small mb-0">
                    @foreach (var slot in Model.Schedule)
                    {
                        <li>@DisplayText.Day(slot.DayOfWeek): @slot.StartTime - @slot.EndTime (@slot.SlotMinutes dk)</li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
