@model AppointmentListViewModel
@{
    ViewData["Title"] = "Randevularım";
    var statuses = new[] { "Pending", "Confirmed", "Completed", "Cancelled" };
}


<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h4 mb-0">Randevularım</h1>
    <a class="btn btn-accent btn-sm" asp-area="" asp-controller="Doctors" asp-action="Index">Yeni randevu al</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-auto">
        <label for="status" class="visually-hidden">Durum</label>
        <select id="status" name="status" class="form-select form-select-sm">
            <option value="">Tüm durumlar</option>
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(Model.Status == s)">@DisplayText.AppointmentStatus(s)</option>
            }
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary btn-sm">Süz</button></div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="panel-card p-4 text-muted">Henüz randevunuz yok.</div>
}
else
{
    <div class="panel-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Tarih</th><th>Doktor</th><th>Durum</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Items)
                    {
                        <tr>
                            <td>@DisplayText.DateTimeLocal(row.Appointment.AppointmentDate)</td>
                            <td>@row.DoctorName</td>
                            <td><span class="badge @DisplayText.AppointmentBadge(row.Appointment.Status)">@DisplayText.AppointmentStatus(row.Appointment.Status)</span></td>
                            <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@row.Appointment.Id">Ayrıntı</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
