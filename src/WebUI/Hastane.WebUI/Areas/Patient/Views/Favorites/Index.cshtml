@using Hastane.WebUI.ViewModels.Social
@model FavoritesViewModel
@{
    ViewData["Title"] = "Favori doktorlarım";
}

<h1 class="page-title">Favori doktorlarım</h1>

@if (Model.Doctors.Count == 0)
{
    <div class="panel-card p-4">
        <partial name="_EmptyState" model="@("Henüz favori doktorunuz yok. Doktor kartlarındaki kalp düğmesiyle ekleyebilirsiniz.")" />
        <div class="text-center mt-2"><a class="btn btn-accent btn-sm" asp-area="" asp-controller="Doctors" asp-action="Index">Doktor bul</a></div>
    </div>
}
else
{
    @foreach (var card in Model.Doctors)
    {
        <partial name="_DoctorCard" model="card" />
    }
}
