@model InvoiceListViewModel
@{
    ViewData["Title"] = "Faturalarım";
}


<h1 class="h4 mb-3">Faturalarım</h1>

@if (Model.Items.Count == 0)
{
    <div class="panel-card p-4 text-muted">Henüz faturanız yok.</div>
}
else
{
    <div class="panel-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Fatura no</th><th>Tarih</th><th>Doktor</th><th>Toplam</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Items)
                    {
                        var i = row.Invoice;
                        <tr>
                            <td>@i.InvoiceNumber</td>
                            <td>@DisplayText.DateLocal(i.IssuedAt)</td>
                            <td>@row.DoctorName</td>
                            <td>@DisplayText.Money(i.Total, i.Currency)</td>
                            <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@i.Id">Ayrıntı</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Sayfalar">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)">Önceki</a></li>
                <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)">Sonraki</a></li>
            </ul>
        </nav>
    }
}
