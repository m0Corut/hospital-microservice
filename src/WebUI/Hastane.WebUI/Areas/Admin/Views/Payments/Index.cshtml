@model PaymentIndexViewModel
@{
    ViewData["Title"] = "Ödemeler";
    var statuses = new[] { "Pending", "Paid", "Failed", "Refunded" };
    var filters = new Dictionary<string, string?>
    {
        ["Status"] = Model.Filter.Status, ["PatientId"] = Model.Filter.PatientId, ["DoctorId"] = Model.Filter.DoctorId,
    };
    var pager = new PagerViewModel
    {
        Action = "Index", Page = Model.Page.Page, PageSize = Model.Page.PageSize, TotalCount = Model.Page.TotalCount, Filters = filters,
    };
}

<h1 class="h4 mb-3">Ödemeler</h1>

<form method="get" asp-action="Index" class="panel-card p-3 mb-3 row g-2">
    <div class="col-md-3">
        <label for="Status" class="form-label small">Durum</label>
        <select id="Status" name="Status" class="form-select">
            <option value="">Tümü</option>
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(Model.Filter.Status == s)">@AdminDisplay.PaymentStatus(s)</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label for="PatientId" class="form-label small">Hasta Id</label>
        <input id="PatientId" name="PatientId" value="@Model.Filter.PatientId" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="DoctorId" class="form-label small">Doktor Id</label>
        <input id="DoctorId" name="DoctorId" value="@Model.Filter.DoctorId" class="form-control" />
    </div>
    <div class="col-md-2 d-grid"><button type="submit" class="btn btn-outline-primary mt-auto">Filtrele</button></div>
</form>

<div class="panel-card p-3">
    @if (Model.Page.Items.Count == 0)
    {
        <p class="text-muted mb-0">Ödeme bulunamadı.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Tarih</th><th>Doktor</th><th>Tutar</th><th>Durum</th><th>Fatura</th><th class="text-end">İşlem</th></tr></thead>
                <tbody>
                @foreach (var p in Model.Page.Items)
                {
                    <tr>
                        <td>@AdminDisplay.Date(p.CreatedAt)</td>
                        <td>@Model.Lookups.Doctor(p.DoctorId)</td>
                        <td>@AdminDisplay.Money(p.Amount, p.Currency)</td>
                        <td><span class="badge @AdminDisplay.StatusBadge(p.Status)">@AdminDisplay.PaymentStatus(p.Status)</span></td>
                        <td class="small">@p.InvoiceNumber</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@p.Id">Ayrıntı</a>
                            @if (p.Status == "Paid")
                            {
                                <a class="btn btn-outline-danger btn-sm" asp-action="Refund" asp-route-id="@p.Id">İade</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <partial name="_Pager" model="pager" />
        </div>
    }
</div>
