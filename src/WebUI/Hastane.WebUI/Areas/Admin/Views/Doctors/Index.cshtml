@model DoctorIndexViewModel
@{
    ViewData["Title"] = "Doktorlar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Doktorlar</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">Doktor ekle</a>
</div>

<form method="get" asp-area="Admin" asp-action="Index" class="panel-card p-3 mb-3 row g-2">
    <div class="col-md-5">
        <label for="text" class="form-label small">Ad ara</label>
        <input id="text" name="text" value="@Model.Text" class="form-control" />
    </div>
    <div class="col-md-4">
        <label for="branchId" class="form-label small">Branş</label>
        <select id="branchId" name="branchId" class="form-select" asp-items="Model.BranchChoices">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-md-3 d-grid align-items-end">
        <button type="submit" class="btn btn-outline-primary mt-auto">Ara</button>
    </div>
</form>

<div class="panel-card p-3">
    @if (Model.Page.Items.Count == 0)
    {
        <p class="text-muted mb-0">Kayıt bulunamadı.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Doktor</th><th>Branş</th><th>Şehir</th><th class="text-end">İşlem</th></tr></thead>
                <tbody>
                @foreach (var d in Model.Page.Items)
                {
                    <tr>
                        <td>@AdminDisplay.FullName(d)</td>
                        <td>@(Model.BranchNames.TryGetValue(d.BranchId, out var bn) ? bn : d.BranchId)</td>
                        <td>@d.PrimaryCity</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@d.Id">Düzenle</a>
                            <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@d.Id">Sil</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <partial name="_Pager" model='new PagerViewModel { Action = "Index", Page = Model.Page.Page, PageSize = Model.Page.PageSize, TotalCount = Model.Page.TotalCount, Filters = new() { ["text"] = Model.Text, ["branchId"] = Model.BranchId } }' />
        </div>
    }
</div>
