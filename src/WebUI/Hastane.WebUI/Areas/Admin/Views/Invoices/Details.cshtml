@model InvoiceDetailsViewModel
@{
    ViewData["Title"] = "Fatura";
    var inv = Model.Invoice;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Fatura @inv.InvoiceNumber</h1>
    <a class="btn btn-link btn-sm" asp-action="Index">Listeye dön</a>
</div>

<div class="panel-card p-4 mb-3">
    <dl class="row mb-0">
        <dt class="col-sm-3">Tarih</dt><dd class="col-sm-9">@AdminDisplay.Date(inv.IssuedAt)</dd>
        <dt class="col-sm-3">Doktor</dt><dd class="col-sm-9">@Model.Lookups.Doctor(inv.DoctorId)</dd>
        <dt class="col-sm-3">Hasta Id</dt><dd class="col-sm-9"><code>@inv.PatientId</code></dd>
        <dt class="col-sm-3">Ödeme</dt><dd class="col-sm-9"><a asp-controller="Payments" asp-action="Details" asp-route-id="@inv.PaymentId">Ödemeye git</a></dd>
    </dl>
</div>

<div class="panel-card p-3">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead><tr><th>Açıklama</th><th class="text-end">Adet</th><th class="text-end">Birim fiyat</th><th class="text-end">Tutar</th></tr></thead>
            <tbody>
            @foreach (var l in inv.Lines)
            {
                <tr>
                    <td>@l.Description</td>
                    <td class="text-end">@l.Quantity</td>
                    <td class="text-end">@AdminDisplay.Money(l.UnitPrice, inv.Currency)</td>
                    <td class="text-end">@AdminDisplay.Money(l.LineTotal, inv.Currency)</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr><td colspan="3" class="text-end">Ara toplam</td><td class="text-end">@AdminDisplay.Money(inv.Subtotal, inv.Currency)</td></tr>
                <tr><td colspan="3" class="text-end">KDV (%@inv.TaxPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))</td><td class="text-end">@AdminDisplay.Money(inv.TaxAmount, inv.Currency)</td></tr>
                <tr class="fw-bold"><td colspan="3" class="text-end">Toplam</td><td class="text-end">@AdminDisplay.Money(inv.Total, inv.Currency)</td></tr>
            </tfoot>
        </table>
    </div>
</div>
