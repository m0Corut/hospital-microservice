@model InvoiceIndexViewModel
@{
    ViewData["Title"] = "Faturalar";
    var pager = new PagerViewModel
    {
        Action = "Index",
        Page = Model.Page.Page,
        PageSize = Model.Page.PageSize,
        TotalCount = Model.Page.TotalCount,
        Filters = new Dictionary<string, string?> { ["PatientId"] = Model.Filter.PatientId, ["DoctorId"] = Model.Filter.DoctorId },
    };
}

<h1 class="h4 mb-3">Faturalar</h1>

<form method="get" asp-action="Index" class="panel-card p-3 mb-3 row g-2">
    <div class="col-md-5">
        <label for="PatientId" class="form-label small">Hasta Id</label>
        <input id="PatientId" name="PatientId" value="@Model.Filter.PatientId" class="form-control" />
    </div>
    <div class="col-md-5">
        <label for="DoctorId" class="form-label small">Doktor Id</label>
        <input id="DoctorId" name="DoctorId" value="@Model.Filter.DoctorId" class="form-control" />
    </div>
    <div class="col-md-2 d-grid"><button type="submit" class="btn btn-outline-primary mt-auto">Filtrele</button></div>
</form>

<div class="panel-card p-3">
    @if (Model.Page.Items.Count == 0)
    {
        <p class="text-muted mb-0">Fatura bulunamadı.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Fatura no</th><th>Tarih</th><th>Doktor</th><th class="text-end">Toplam</th><th class="text-end">İşlem</th></tr></thead>
                <tbody>
                @foreach (var i in Model.Page.Items)
                {
                    <tr>
                        <td>@i.InvoiceNumber</td>
                        <td>@AdminDisplay.Date(i.IssuedAt)</td>
                        <td>@Model.Lookups.Doctor(i.DoctorId)</td>
                        <td class="text-end">@AdminDisplay.Money(i.Total, i.Currency)</td>
                        <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@i.Id">Ayrıntı</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <partial name="_Pager" model="pager" />
        </div>
    }
</div>
