@using Hastane.WebUI.ViewModels.Pharmacy
@model PharmacyDispensationsViewModel
@{
    ViewData["Title"] = "Karşılanan reçeteler";
    var pager = new PagerViewModel
    {
        Action = "Dispensations", Page = Model.Page.Page, PageSize = Model.Page.PageSize, TotalCount = Model.Page.TotalCount,
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Karşılanan reçeteler</h1>
    <a class="btn btn-primary btn-sm" asp-action="Index">Reçete karşıla</a>
</div>

<div class="panel-card p-3">
    @if (Model.Page.Items.Count == 0)
    {
        <p class="text-muted mb-0">Henüz karşılanan reçete yok.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Tarih</th><th>Reçete</th><th>İlaçlar</th><th class="text-end">Tutar</th></tr></thead>
                <tbody>
                @foreach (var d in Model.Page.Items)
                {
                    <tr>
                        <td>@AdminDisplay.Date(d.DispensedAt)</td>
                        <td class="small"><a asp-action="Index" asp-route-prescriptionId="@d.PrescriptionId">@d.PrescriptionId</a></td>
                        <td>@string.Join(", ", d.Lines.OrderBy(l => l.LineNo).Select(l => l.MedicineName))</td>
                        <td class="text-end">@PharmacyDisplay.Money(d.Total, d.Currency)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <partial name="_Pager" model="pager" />
        </div>
    }
</div>
