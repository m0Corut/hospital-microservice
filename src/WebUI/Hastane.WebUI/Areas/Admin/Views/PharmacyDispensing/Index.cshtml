@using Hastane.WebUI.ViewModels.Pharmacy
@model PharmacyDispenseViewModel
@{
    ViewData["Title"] = "Reçete Karşıla";
    var preview = Model.Preview;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Reçete Karşıla</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Dispensations">Karşılananlar</a>
</div>

@if (ViewData["WarningNow"] is string warning)
{
    <div class="alert alert-warning py-2 small">@warning</div>
}

<form method="get" asp-action="Index" class="panel-card p-3 mb-3 row g-2">
    <div class="col-md-10">
        <label for="prescriptionId" class="form-label small">Reçete Id</label>
        <input id="prescriptionId" name="prescriptionId" value="@Model.PrescriptionId" class="form-control" autocomplete="off" />
        <span asp-validation-for="PrescriptionId" class="text-danger small"></span>
    </div>
    <div class="col-md-2 d-grid"><button type="submit" class="btn btn-outline-primary mt-auto">Önizle</button></div>
</form>

@if (preview is not null)
{
    <div class="panel-card p-3">
        <div class="d-flex justify-content-between flex-wrap mb-2">
            <div class="small text-muted">Reçete @preview.PrescriptionId · Hasta @preview.PatientId · Doktor @preview.DoctorId</div>
            @if (preview.AlreadyDispensed)
            {
                <span class="badge text-bg-secondary">Zaten karşılandı</span>
            }
            else if (preview.CanDispense)
            {
                <span class="badge text-bg-success">Karşılanabilir</span>
            }
            else
            {
                <span class="badge text-bg-danger">Karşılanamaz</span>
            }
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>#</th><th>Reçetedeki ad</th><th>Eşleşen ilaç</th><th class="text-end">Gerekli</th><th class="text-end">Stok</th><th>Durum</th></tr></thead>
                <tbody>
                @foreach (var line in preview.Lines.OrderBy(l => l.LineNo))
                {
                    <tr>
                        <td>@line.LineNo</td>
                        <td>@line.PrescriptionMedicineName</td>
                        <td>@(line.MedicineName ?? "-")</td>
                        <td class="text-end">@line.Required</td>
                        <td class="text-end">@(line.MedicineId is null ? "-" : line.Available.ToString())</td>
                        <td><span class="badge @PharmacyDisplay.LineBadge(line.Status)">@PharmacyDisplay.LineStatus(line.Status)</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (preview.AlreadyDispensed)
        {
            <p class="text-muted small mt-3 mb-0">Bu reçete daha önce karşılandı; tekrar karşılanamaz.</p>
        }
        else if (preview.CanDispense)
        {
            <form asp-action="Dispense" method="post" class="mt-3"
                  onsubmit="return confirm('Reçete karşılanacak ve stoklar düşülecek. Onaylıyor musunuz?');">
                <input type="hidden" name="prescriptionId" value="@preview.PrescriptionId" />
                <button type="submit" class="btn btn-primary">Karşıla</button>
            </form>
        }
        else
        {
            <p class="text-danger small mt-3 mb-0">Kırmızı kalemler çözülmeden reçete karşılanamaz. Hiçbir ilaç kısmen düşülmez.</p>
        }
    </div>
}
