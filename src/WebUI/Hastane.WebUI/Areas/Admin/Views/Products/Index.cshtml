@using Hastane.WebUI.ViewModels.Shop
@model AdminProductListViewModel
@{
    ViewData["Title"] = "Ürünler";
}
@section Styles {
    <link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Ürünler</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">Ürün ekle</a>
</div>

<form method="get" asp-area="Admin" asp-controller="Products" asp-action="Index" class="panel-card p-3 mb-3 row g-2 align-items-end">
    <div class="col-md-5">
        <label for="q" class="form-label small mb-1">Ara</label>
        <input type="search" id="q" name="q" value="@Model.Search" class="form-control" maxlength="100" />
    </div>
    <div class="col-md-4">
        <label for="category" class="form-label small mb-1">Kategori</label>
        <select id="category" name="category" class="form-select">
            <option value="">Tümü</option>
            @foreach (var (key, label, _) in ShopDisplay.Categories)
            {
                <option value="@key" selected="@(Model.Category == key)">@label</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-grid"><button type="submit" class="btn btn-outline-primary">Filtrele</button></div>
</form>

<div class="panel-card p-3">
    @if (Model.Items.Count == 0)
    {
        <p class="text-muted mb-0">Ürün bulunamadı.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th></th><th>Ad</th><th>Kategori</th><th class="text-end">Fiyat</th><th class="text-end">Stok</th><th>Durum</th><th class="text-end">İşlem</th></tr></thead>
                <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td><img class="admin-product-thumb" src="@ShopDisplay.Image(p.ImageUrl)" alt="" /></td>
                        <td>@p.Name</td>
                        <td class="text-muted small">@ShopDisplay.CategoryLabel(p.Category)</td>
                        <td class="text-end text-nowrap">@ShopDisplay.Money(p.Price, p.Currency)</td>
                        <td class="text-end"><span class="@(p.Stock == 0 ? "text-danger fw-semibold" : "")">@p.Stock</span></td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge text-bg-success">Satışta</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Pasif</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@p.Id">Düzenle</a>
                            <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@p.Id">Sil</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="mt-3"><partial name="_Pager" model="Model.Pager" /></div>
    }
</div>
