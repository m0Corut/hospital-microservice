@{
    ViewData["Title"] = "Kullanıcılar";
}

<h1 class="h4 mb-3">Kullanıcılar</h1>

<div class="panel-card p-4">
    <p class="text-muted small">Kimlik servisi kullanıcı listesi sunmaz; kullanıcıyı Id'si (GUID) ile bulabilirsiniz.</p>
    <form method="get" asp-area="Admin" asp-controller="Users" asp-action="Index" class="row g-2">
        <div class="col-md-9">
            <label for="id" class="form-label visually-hidden">Kullanıcı Id</label>
            <input id="id" name="id" class="form-control" placeholder="Kullanıcı Id (ör. 3f2b1c9e-...)" />
        </div>
        <div class="col-md-3 d-grid">
            <button type="submit" class="btn btn-primary">Bul</button>
        </div>
    </form>
</div>
