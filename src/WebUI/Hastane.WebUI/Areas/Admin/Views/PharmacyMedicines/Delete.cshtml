@using Hastane.WebUI.Models.Api.Pharmacy
@model PharmacyMedicineApiModel
@{
    ViewData["Title"] = "İlacı sil";
}

<div class="panel-card p-4">
    <h1 class="h4">İlacı sil</h1>
    <p><strong>@Model.Name</strong> (@Model.Strength) ilacını kataloğtan kaldırmak istediğinize emin misiniz?</p>
    <p class="text-muted small">Stok hareketleri ve karşılama kayıtları korunur; ilaç listede ve reçete eşleştirmesinde görünmez olur.</p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger">Evet, sil</button>
        <a class="btn btn-link" asp-action="Index">Vazgeç</a>
    </form>
</div>
