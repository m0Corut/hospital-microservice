@using Hastane.WebUI.ViewModels.Pharmacy
@model PharmacyMovementsViewModel
@{
    ViewData["Title"] = "Stok hareketleri";
    var pager = new PagerViewModel
    {
        Action = "Movements", Page = Model.Page.Page, PageSize = Model.Page.PageSize, TotalCount = Model.Page.TotalCount,
        Filters = new Dictionary<string, string?> { ["id"] = Model.Medicine.Id.ToString() },
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Stok hareketleri</h1>
        <div class="text-muted small">@Model.Medicine.Name · mevcut stok @Model.Medicine.Stock</div>
    </div>
    <div>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Stock" asp-route-id="@Model.Medicine.Id">Stok düzelt</a>
        <a class="btn btn-link btn-sm" asp-action="Index">İlaçlara dön</a>
    </div>
</div>

<div class="panel-card p-3">
    @if (Model.Page.Items.Count == 0)
    {
        <p class="text-muted mb-0">Henüz hareket yok.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Tarih</th><th>Tür</th><th class="text-end">Değişim</th><th class="text-end">Sonraki stok</th><th>Neden</th></tr></thead>
                <tbody>
                @foreach (var s in Model.Page.Items)
                {
                    <tr>
                        <td>@AdminDisplay.Date(s.CreatedAt)</td>
                        <td>@PharmacyDisplay.MovementType(s.Type)</td>
                        <td class="text-end"><span class="badge @(s.Delta > 0 ? "text-bg-success" : "text-bg-warning")">@PharmacyDisplay.Signed(s.Delta)</span></td>
                        <td class="text-end">@s.StockAfter</td>
                        <td class="small">
                            @s.Reason
                            @if (s.PrescriptionId is not null)
                            {
                                <a class="ms-1" asp-controller="PharmacyDispensing" asp-action="Index" asp-route-prescriptionId="@s.PrescriptionId">reçete</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <partial name="_Pager" model="pager" />
        </div>
    }
</div>
