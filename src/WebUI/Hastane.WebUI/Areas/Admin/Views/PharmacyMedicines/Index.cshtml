@using Hastane.WebUI.ViewModels.Pharmacy
@using Hastane.WebUI.Models.Api.Pharmacy
@model PharmacyMedicineIndexViewModel
@{
    ViewData["Title"] = "İlaçlar";
    var filters = new Dictionary<string, string?>
    {
        ["Search"] = Model.Filter.Search, ["Form"] = Model.Filter.Form,
    };
    var pager = new PagerViewModel
    {
        Action = "Index", Page = Model.Page.Page, PageSize = Model.Page.PageSize, TotalCount = Model.Page.TotalCount, Filters = filters,
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">İlaçlar</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">İlaç ekle</a>
</div>

<form method="get" asp-action="Index" class="panel-card p-3 mb-3 row g-2">
    <div class="col-md-6">
        <label for="Search" class="form-label small">Ara (ad, etken madde, barkod)</label>
        <input id="Search" name="Search" value="@Model.Filter.Search" class="form-control" />
    </div>
    <div class="col-md-4">
        <label for="Form" class="form-label small">Form</label>
        <select id="Form" name="Form" class="form-select">
            <option value="">Tümü</option>
            @foreach (var f in PharmacyDisplay.Forms)
            {
                <option value="@f" selected="@(Model.Filter.Form == f)">@PharmacyDisplay.Form(f)</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-grid"><button type="submit" class="btn btn-outline-primary mt-auto">Süz</button></div>
</form>

<div class="panel-card p-3">
    @if (Model.Page.Items.Count == 0)
    {
        <p class="text-muted mb-0">İlaç bulunamadı.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Ad</th><th>Form</th><th>Doz</th><th>Barkod</th><th class="text-end">Fiyat</th><th class="text-end">Stok</th><th class="text-end">İşlem</th></tr>
                </thead>
                <tbody>
                @foreach (var m in Model.Page.Items)
                {
                    <tr>
                        <td>
                            @m.Name
                            @if (m.RequiresPrescription)
                            {
                                <span class="badge text-bg-info ms-1">Reçeteli</span>
                            }
                            <div class="text-muted small">@m.ActiveIngredient</div>
                        </td>
                        <td>@PharmacyDisplay.Form(m.Form)</td>
                        <td>@m.Strength</td>
                        <td class="small">@m.Barcode</td>
                        <td class="text-end">@PharmacyDisplay.Money(m.Price, m.Currency)</td>
                        <td class="text-end">
                            @m.Stock
                            @if (m.IsLowStock)
                            {
                                <span class="badge text-bg-danger ms-1" title="Asgari stok: @m.MinStock">Düşük stok</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Stock" asp-route-id="@m.Id">Stok</a>
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Movements" asp-route-id="@m.Id">Hareketler</a>
                            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@m.Id">Düzenle</a>
                            <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@m.Id">Sil</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <partial name="_Pager" model="pager" />
        </div>
    }
</div>
