@using Hastane.WebUI.ViewModels.Pharmacy
@model PharmacyStockViewModel
@{
    ViewData["Title"] = "Stok düzelt";
}

<div class="panel-card p-4">
    <h1 class="h4 mb-1">Stok düzelt</h1>
    <p class="text-muted">@Model.MedicineName · mevcut stok: <strong>@Model.CurrentStock</strong></p>
    <form asp-action="Stock" asp-route-id="@Model.Id" method="post" novalidate>
        <div asp-validation-summary="All" class="alert alert-danger py-2 small"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Delta" class="form-label"></label>
                <input asp-for="Delta" class="form-control" type="number" step="1" />
                <span asp-validation-for="Delta" class="text-danger small"></span>
            </div>
            <div class="col-md-8">
                <label asp-for="Reason" class="form-label"></label>
                <input asp-for="Reason" class="form-control" maxlength="200" />
                <span asp-validation-for="Reason" class="text-danger small"></span>
            </div>
        </div>
        <div class="form-text mt-2">Stok eksiye düşürülemez. Her değişiklik "Hareketler" kaydına yazılır.</div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a class="btn btn-link" asp-action="Index">Vazgeç</a>
        </div>
    </form>
</div>
