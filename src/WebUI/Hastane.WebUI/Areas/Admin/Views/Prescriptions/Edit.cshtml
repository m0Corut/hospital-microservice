@model PrescriptionFormViewModel
@using Hastane.WebUI.ViewModels.DoctorPanel
@{
    ViewData["Title"] = "Reçeteyi düzenle";
    ViewData["FormArea"] = "Admin";
    ViewData["CancelUrl"] = Url.Action("Details", "Prescriptions", new { area = "Admin", id = Model.PrescriptionId });
}

<h1 class="page-title">Reçeteyi düzenle</h1>

<div class="panel-card p-4">
    <p class="text-muted"><strong>@Model.PatientLabel</strong></p>
    <partial name="_PrescriptionForm" model="Model" />
</div>
