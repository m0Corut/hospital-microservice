@inject Hastane.WebUI.Clients.IAdminDoctorApplicationClient DoctorApplications
@{
    // Bekleyen başvuru sayısı (menü rozeti). Servis kapalı / yetkisiz ise null: rozet çıkmaz, sayfa bozulmaz.
    var pendingApplications = await DoctorApplications.CountPendingAsync(Context.RequestAborted);
    var applicationsLabel = pendingApplications is > 0 ? $"Doktor Başvuruları ({pendingApplications})" : "Doktor Başvuruları";
    // Admin paneli iskeleti: ortak _Layout içinde profil kartlı kenar menü + içerik. Yetki burada değil, AdminAreaController'dadır.
    Layout = "~/Views/Shared/_Layout.cshtml";
    var side = new PanelSideViewModel(
        User.Identity?.Name ?? string.Empty,
        "Yönetici",
        null,
        [
            new("speedometer2", "Panel", "Admin", "Home"),
            new("grid", "Branşlar", "Admin", "Branches"),
            new("person-badge", "Doktorlar", "Admin", "Doctors"),
            new("person-check", applicationsLabel, "Admin", "DoctorApplications"),
            new("people", "Kullanıcılar", "Admin", "Users"),
            new("person-heart", "Hastalar", "Admin", "Patients"),
            new("shield-lock", "Roller", "Admin", "Roles"),
            new("calendar-check", "Randevular", "Admin", "Appointments"),
            new("credit-card", "Ödemeler", "Admin", "Payments"),
            new("receipt", "Faturalar", "Admin", "Invoices"),
            new("file-earmark-medical", "Reçeteler", "Admin", "Prescriptions"),
            new("chat-square-text", "Yorumlar", "Admin", "Reviews"),
            new("person-gear", "Hesap ayarları", "", "Account", "Profile"),
        ]);
}

<div class="panel-shell">
    <partial name="_PanelSide" model="side" />
    <div class="panel-content">
        @RenderBody()
    </div>
</div>

@* İç içe düzen: sayfaların Styles/Scripts bölümlerini ana _Layout'a iletir (yoksa bölüm tanımlayan sayfa 500 verir). *@
@section Styles { @await RenderSectionAsync("Styles", required: false) }
@section Scripts { @await RenderSectionAsync("Scripts", required: false) }
