@{
    // Admin paneli iskeleti: ortak _Layout içinde profil kartlı kenar menü + içerik. Yetki burada değil, AdminAreaController'dadır.
    Layout = "~/Views/Shared/_Layout.cshtml";
    var side = new PanelSideViewModel(
        User.Identity?.Name ?? string.Empty,
        "Yönetici",
        null,
        [
            new("speedometer2", "Panel", "Admin", "Home"),
            new("grid", "Branşlar", "Admin", "Branches"),
            new("person-badge", "Doktorlar", "Admin", "Doctors"),
            new("people", "Kullanıcılar", "Admin", "Users"),
            new("shield-lock", "Roller", "Admin", "Roles"),
            new("calendar-check", "Randevular", "Admin", "Appointments"),
            new("credit-card", "Ödemeler", "Admin", "Payments"),
            new("receipt", "Faturalar", "Admin", "Invoices"),
            new("file-earmark-medical", "Reçeteler", "Admin", "Prescriptions"),
            new("person-gear", "Hesap ayarları", "", "Account", "Profile"),
        ]);
}

<div class="panel-shell">
    <partial name="_PanelSide" model="side" />
    <div class="panel-content">
        @RenderBody()
    </div>
</div>
