@model List<AdminBranchApiModel>
@{
    ViewData["Title"] = "Branşlar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Branşlar</h1>
    <a class="btn btn-primary btn-sm" asp-action="Create">Branş ekle</a>
</div>

<div class="panel-card p-3">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">Henüz branş yok.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Ad</th><th>Açıklama</th><th class="text-end">İşlem</th></tr></thead>
                <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>@b.Name</td>
                        <td class="text-muted small">@b.Description</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@b.Id">Düzenle</a>
                            <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@b.Id">Sil</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
