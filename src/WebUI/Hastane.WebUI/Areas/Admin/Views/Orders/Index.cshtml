@using Hastane.WebUI.ViewModels.Orders
@model AdminOrderIndexViewModel
@{
    ViewData["Title"] = "Siparişler";
    var filters = new Dictionary<string, string?> { ["Status"] = Model.Filter.Status };
    var pager = new PagerViewModel
    {
        Action = "Index", Page = Model.Page.Page, PageSize = Model.Page.PageSize, TotalCount = Model.Page.TotalCount, Filters = filters,
    };
}

<h1 class="h4 mb-3">Siparişler</h1>

<form method="get" asp-action="Index" class="panel-card p-3 mb-3 row g-2">
    <div class="col-md-4">
        <label for="Status" class="form-label small">Durum</label>
        <select id="Status" name="Status" class="form-select">
            <option value="">Tümü</option>
            @foreach (var s in OrderDisplay.Statuses)
            {
                <option value="@s" selected="@(Model.Filter.Status == s)">@OrderDisplay.Status(s)</option>
            }
        </select>
    </div>
    <div class="col-md-2 d-grid"><button type="submit" class="btn btn-outline-primary mt-auto">Filtrele</button></div>
</form>

<div class="panel-card p-3">
    @if (Model.Page.Items.Count == 0)
    {
        <p class="text-muted mb-0">Sipariş bulunamadı.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Sipariş no</th><th>Tarih</th><th>Hasta</th><th>Tutar</th><th>Durum</th><th class="text-end">İşlem</th></tr></thead>
                <tbody>
                @foreach (var o in Model.Page.Items)
                {
                    <tr>
                        <td><code>@o.OrderNumber</code></td>
                        <td>@AdminDisplay.Date(o.CreatedAt)</td>
                        <td>@o.PatientName</td>
                        <td>@OrderDisplay.Money(o.TotalAmount, o.Currency)</td>
                        <td><span class="badge @OrderDisplay.Badge(o.Status)">@OrderDisplay.Status(o.Status)</span></td>
                        <td class="text-end"><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@o.Id">Ayrıntı</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <partial name="_Pager" model="pager" />
        </div>
    }
</div>
