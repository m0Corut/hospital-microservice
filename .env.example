# Kopyala: .env  (gerçek .env depoya girmez)
MONGO_USER=hastane
MONGO_PASSWORD=degistir
# SQL Server en az 8 karakter, büyük + küçük harf + rakam + sembol ister
SQL_SA_PASSWORD=Degistir_123!

# İlk Admin hesabı (yalnız sistemde hiç Admin yoksa oluşturulur; scripts/setup-dev.ps1 Identity'ye yazar)
ADMIN_EMAIL=admin@hastane.local
ADMIN_PASSWORD=Admin12345!

# MariaDB (Order servisi), Redis (Market: önbellek + sepet), RabbitMQ (olay tabanlı iletişim)
MARIADB_ROOT_PASSWORD=Degistir_123!
REDIS_PASSWORD=degistir
RABBITMQ_USER=hastane
RABBITMQ_PASSWORD=degistir

# --- Docker ile tam sistem (docker-compose.full.yml, scripts/docker-up.ps1) ---------------------------------------
# NOT: .env'de `$` karakteri compose tarafından değişken sanılır; parolada `$` kullanmayın (ya da `$$` yazın).
# SQL_SA_PASSWORD içinde `;` kullanmayın (bağlantı cümlesini bozar). MONGO_PASSWORD içinde `@ : / ? # %` kullanmayın
# (mongodb:// adresinde kaçışsız yazılıyor); yalnız harf, rakam, `_` ve `-` en güvenlisi.

# Servisler arası iç anahtar (Identity, Appointment, Notification, Order, Market... hepsi AYNI değer).
# docker-up.ps1 boşsa rastgele üretip buraya yazar. Elle: openssl rand -base64 32
INTERNAL_API_KEY=

# Tarayıcının gördüğü adresler. Yerelde varsayılanlar yeterli; VPS + Caddy'de ikisi de https://alanadi olur.
PUBLIC_WEB_URL=http://localhost:5010
PUBLIC_GATEWAY_URL=http://localhost:5000

# Ters vekil (Caddy, `--profile proxy`) alan adı. Yalnız VPS'te.
DOMAIN=

# Altyapı + WebUI + Gateway portları hangi adrese bağlansın. 127.0.0.1 = yalnız bu makine (güvenli varsayılan).
# 0.0.0.0 YAPMAYIN: Docker yayımlanan portları ufw güvenlik duvarını atlayarak internete açar.
BIND_ADDRESS=127.0.0.1

# SQL Server'a ayrılan bellek (MB). En az 2048 önerilir.
SQL_MEMORY_LIMIT_MB=2048

# Örnek veri aracının (DevSeed) doktor/hasta hesap parolası. Herkese açık sunucuda MUTLAKA değiştirin.
SEED_PASSWORD=Hastane123!

# Market demo ürünleri (yalnız ilk kurulumda true; sonra false)
MARKET_SEED_DEMO_DATA=false

# "extra" profili (Elasticsearch + Kafka + Analytics) açıkken docker-up.ps1 -Extra bunları kendisi ayarlar:
# ELASTICSEARCH_URL=http://elasticsearch:9200
# KAFKA_BOOTSTRAP_SERVERS=kafka:9094