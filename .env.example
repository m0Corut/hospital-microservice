# Kopyala: .env  (gerçek .env depoya girmez)
MONGO_USER=hastane
MONGO_PASSWORD=degistir
# SQL Server en az 8 karakter, büyük + küçük harf + rakam + sembol ister
SQL_SA_PASSWORD=Degistir_123!

# İlk Admin hesabı (yalnız sistemde hiç Admin yoksa oluşturulur; scripts/setup-dev.ps1 Identity'ye yazar)
ADMIN_EMAIL=admin@hastane.local
ADMIN_PASSWORD=Admin12345!

# MariaDB (Order servisi), Redis (Market: önbellek + sepet), RabbitMQ (olay tabanlı iletişim)
MARIADB_ROOT_PASSWORD=Degistir_123!
REDIS_PASSWORD=degistir
RABBITMQ_USER=hastane
RABBITMQ_PASSWORD=degistir
